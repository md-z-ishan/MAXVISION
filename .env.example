# ==============================================================================
# MAXVISION Optical - Environment Configuration Template
# Store Location: Shop 4, Sheetal Tower, Taxi Stand, Main Road, Ranchi, Jharkhand 834001
# IMPORTANT: Copy this file to .env and replace placeholder values for production.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set to 'False' in production. When False, strict HTTPS, secure cookies, and secret checks are enforced.
DJANGO_DEBUG=True

# In production (DJANGO_DEBUG=False), you MUST generate a long random 50+ character string.
# Example generator: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=django-insecure-dev-key

# Comma-separated list of allowed hostnames or IP addresses.
# Production Example: maxvisionoptical.com,www.maxvisionoptical.com,127.0.0.1
ALLOWED_HOSTS=*

# --- DATABASE CONFIGURATION ---
# Default local development uses SQLite.
# Production uses PostgreSQL. Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# DATABASE_URL=postgres://maxvision_user:strongpassword@localhost:5432/maxvision_db
DATABASE_URL=sqlite:///db.sqlite3

# --- CORS & CSRF TRUSTED ORIGINS ---
# Comma-separated origins allowed to make API requests to this backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SECURITY & SSL (Enforced when DJANGO_DEBUG=False) ---
# Set to 'True' if backend is served behind SSL/HTTPS.
SECURE_SSL_REDIRECT=False

# --- EMAIL SERVICE ---
# For local testing, console backend logs emails directly to terminal.
# In production, configure SMTP (e.g. SendGrid, Mailgun, Amazon SES).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=support@maxvisionoptical.com
SHOP_NOTIFY_EMAIL=orders@maxvisionoptical.com

# --- STORE BUSINESS METADATA ---
# Note: Verified values provided by store owner. Do not invent or fabricate.
SHOP_GSTIN=
DELIVERY_CHARGE=0.0
UPI_ID=7485067874@ptyes

